// 이 파일은 빌드할 때 자동으로 만들어진다. 직접 고치지 말 것.
// 원본: https://curl.se/ca/cacert.pem
//
// 왜 인증서를 모드 안에 넣는가:
// IXWebSocket은 안드로이드에서 시스템 인증서를 읽지 못한다(구현이 비어 있고
// 그냥 실패를 반환한다). 그래서 wss:// 로 접속하려면 신뢰할 인증서 묶음을
// 우리가 직접 들고 있어야 한다.

namespace coop {

    char const* caBundlePem() {
        return R"COOPCACERT(@COOP_CA_BUNDLE@)COOPCACERT";
    }

}
